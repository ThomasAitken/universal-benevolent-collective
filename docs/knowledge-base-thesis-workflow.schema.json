{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.universalbenevolentcollective.org/knowledge-base-thesis-workflow.schema.json",
  "title": "UBC Knowledge Base Thesis Workflow Record",
  "description": "Mutable review, capability-gate, and lifecycle state for one thesis revision. This record is not part of the immutable thesis content or its content digest.",
  "x-ubc-boundary": {
    "artifact_role": "mutable_workflow",
    "canonical_revision_schema": "knowledge-base-thesis.schema.json",
    "included_in_content_digest": false
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "thesis_id",
    "revision_id",
    "lifecycle_status",
    "status_rationale",
    "capability_gate",
    "review",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "thesis_id": {
      "$ref": "knowledge-base-thesis.schema.json#/$defs/thesisId"
    },
    "revision_id": {
      "$ref": "knowledge-base-thesis.schema.json#/$defs/revisionId"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "draft",
        "under_review",
        "published",
        "disputed",
        "superseded",
        "retracted",
        "archived"
      ]
    },
    "status_rationale": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        {
          "type": "null"
        }
      ],
      "description": "Required for exceptional public states; null for ordinary drafts, reviews, and publications."
    },
    "capability_gate": {
      "$ref": "#/$defs/capabilityGate"
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle_status": {
            "enum": ["published", "disputed", "superseded", "retracted", "archived"]
          }
        },
        "required": ["lifecycle_status"]
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "status": {
                "const": "approved"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_status": {
            "enum": ["disputed", "superseded", "retracted", "archived"]
          }
        },
        "required": ["lifecycle_status"]
      },
      "then": {
        "properties": {
          "status_rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "capabilityGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "outcome",
        "model_profile_id",
        "evaluation_ids",
        "checked_at",
        "explanation"
      ],
      "properties": {
        "policy_id": {
          "$ref": "knowledge-base-thesis.schema.json#/$defs/identifier"
        },
        "outcome": {
          "type": "string",
          "enum": ["not_required", "passed", "failed", "human_override"]
        },
        "model_profile_id": {
          "oneOf": [
            {
              "$ref": "knowledge-base-thesis.schema.json#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "evaluation_ids": {
          "type": "array",
          "items": {
            "$ref": "knowledge-base-thesis.schema.json#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "passed"
              }
            },
            "required": ["outcome"]
          },
          "then": {
            "properties": {
              "model_profile_id": {
                "$ref": "knowledge-base-thesis.schema.json#/$defs/identifier"
              },
              "evaluation_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "reviewDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "reviewer",
        "decision",
        "explanation",
        "independence_basis",
        "conflicts_disclosed",
        "decided_at"
      ],
      "properties": {
        "decision_id": {
          "$ref": "knowledge-base-thesis.schema.json#/$defs/identifier",
          "description": "Stable identifier for this append-only review decision."
        },
        "reviewer": {
          "$ref": "knowledge-base-thesis.schema.json#/$defs/actor"
        },
        "decision": {
          "type": "string",
          "enum": ["approve", "request_changes", "reject", "abstain"]
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "independence_basis": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ],
          "description": "Why this review fills an independent-review slot; null when the decision is not offered for such a slot."
        },
        "conflicts_disclosed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "policy_id",
        "required_review_count",
        "human_approval_required",
        "decisions",
        "published_at"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_started", "pending", "changes_requested", "approved", "rejected"]
        },
        "policy_id": {
          "$ref": "knowledge-base-thesis.schema.json#/$defs/identifier"
        },
        "required_review_count": {
          "type": "integer",
          "minimum": 0
        },
        "human_approval_required": {
          "type": "boolean"
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reviewDecision"
          }
        },
        "published_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
