{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.universalbenevolentcollective.org/knowledge-base-thesis.schema.json",
  "title": "UBC Immutable Knowledge Base Thesis Revision",
  "description": "Authored knowledge and audit provenance for one revision of an empirically grounded UBC thesis. A proposal may use this shape with a null content hash, but the record becomes canonical and immutable only on acceptance. Mutable workflow state and generated service projections are defined in separate schemas. Predictions and forecasting fields are intentionally outside version 1.",
  "x-ubc-boundary": {
    "artifact_role": "immutable_revision",
    "content_digest_excludes": [
      "/revision/content_hash",
      "/provenance",
      "/thesis_created_at",
      "/revision_created_at"
    ],
    "mutable_workflow_schema": "knowledge-base-thesis-workflow.schema.json",
    "composed_read_view_schema": "knowledge-base-thesis-view.schema.json"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "thesis_id",
    "revision",
    "language",
    "statement",
    "description",
    "thesis_type",
    "domains",
    "keywords",
    "content_license",
    "attribution_notice",
    "epistemic_assessment",
    "sources",
    "evidence",
    "hierarchy",
    "related_theses",
    "open_questions",
    "provenance",
    "thesis_created_at",
    "revision_created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "description": "Version of this record schema, independent of the thesis revision number."
    },
    "thesis_id": {
      "$ref": "#/$defs/thesisId"
    },
    "revision": {
      "$ref": "#/$defs/revision"
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
      "description": "BCP 47 language tag for the canonical statement and prose."
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "description": "A self-contained, declarative, independently assessable claim containing one principal proposition and every qualification necessary to avoid materially overgeneralizing it."
    },
    "description": {
      "type": "string",
      "maxLength": 20000,
      "description": "Plain-language explanation of the statement's context, interpretation, significance, definitions, boundaries, exclusions, applicability, and other qualifications that aid understanding without changing the proposition."
    },
    "thesis_type": {
      "type": "string",
      "enum": [
        "descriptive",
        "causal",
        "predictive",
        "methodological",
        "mixed"
      ],
      "description": "The principal empirical form of the thesis. Mixed theses may also contain normative content, but purely normative and purely definitional propositions are outside the knowledge base."
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Curated subject taxonomy terms used for discovery and reviewer routing."
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "uniqueItems": true
    },
    "content_license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "SPDX expression or other published license identifier for UBC-authored thesis content; it does not relicense cited sources."
    },
    "attribution_notice": {
      "type": "string",
      "maxLength": 2000
    },
    "epistemic_assessment": {
      "$ref": "#/$defs/epistemicAssessment"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "description": "Deduplicated bibliography for this revision. Evidence and assessments refer to these source IDs."
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceItem"
      },
      "description": "Structured links between sources and the thesis. Key papers are scholarly evidence items whose evidence_role is key."
    },
    "hierarchy": {
      "$ref": "#/$defs/hierarchy"
    },
    "related_theses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/thesisRelation"
      },
      "description": "Non-hierarchical semantic relationships."
    },
    "open_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openQuestion"
      },
      "description": "Unresolved research questions whose answers could materially affect this thesis. Project status and priority are deliberately excluded."
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "thesis_created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Creation time of the stable thesis identity."
    },
    "revision_created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Creation time of this immutable revision."
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,199}$"
    },
    "thesisId": {
      "type": "string",
      "pattern": "^thesis_[a-z0-9][a-z0-9_-]{7,120}$",
      "description": "Permanent opaque thesis identifier."
    },
    "revisionId": {
      "type": "string",
      "pattern": "^revision_[a-z0-9][a-z0-9_-]{7,118}$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^source_[a-z0-9][a-z0-9_-]{7,120}$"
    },
    "nullableRevisionId": {
      "oneOf": [
        {
          "$ref": "#/$defs/revisionId"
        },
        {
          "type": "null"
        }
      ]
    },
    "strength": {
      "type": "string",
      "enum": [
        "none",
        "very_low",
        "low",
        "medium",
        "high",
        "very_high",
        "unknown",
        "not_applicable"
      ]
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_id",
        "revision_number",
        "previous_revision_id",
        "change_type",
        "change_summary",
        "content_hash"
      ],
      "properties": {
        "revision_id": {
          "$ref": "#/$defs/revisionId"
        },
        "revision_number": {
          "type": "integer",
          "minimum": 1
        },
        "previous_revision_id": {
          "$ref": "#/$defs/nullableRevisionId"
        },
        "change_type": {
          "type": "string",
          "enum": [
            "creation",
            "substantive_revision",
            "evidence_update",
            "assessment_update",
            "metadata_correction",
            "merge"
          ]
        },
        "change_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "content_hash": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ],
          "readOnly": true,
          "description": "SHA-256 hash of the canonical JSON serialization of this immutable revision excluding revision.content_hash, provenance, thesis_created_at, and revision_created_at; null until accepted."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "revision_number": {
                "const": 1
              }
            },
            "required": ["revision_number"]
          },
          "then": {
            "properties": {
              "previous_revision_id": {
                "type": "null"
              },
              "change_type": {
                "const": "creation"
              }
            }
          },
          "else": {
            "properties": {
              "previous_revision_id": {
                "$ref": "#/$defs/revisionId"
              }
            }
          }
        }
      ]
    },
    "basisAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strength", "explanation", "source_ids", "limitations"],
      "properties": {
        "strength": {
          "$ref": "#/$defs/strength"
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceId"
          },
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    },
    "empiricalBasisAssessment": {
      "allOf": [
        {
          "$ref": "#/$defs/basisAssessment"
        },
        {
          "type": "object",
          "properties": {
            "strength": {
              "type": "string",
              "enum": [
                "very_low",
                "low",
                "medium",
                "high",
                "very_high",
                "unknown"
              ]
            },
            "source_ids": {
              "minItems": 1
            }
          }
        }
      ],
      "description": "Required empirical content. At least one source must be cited, and empirical strength cannot be none or not_applicable. Unknown is permitted while the cited empirical material awaits assessment."
    },
    "consensusAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "agreement_strength",
        "community",
        "explanation",
        "source_ids",
        "assessed_at"
      ],
      "properties": {
        "position": {
          "type": "string",
          "enum": [
            "supports",
            "opposes",
            "mixed",
            "no_consensus",
            "unknown"
          ]
        },
        "agreement_strength": {
          "type": "string",
          "enum": [
            "none",
            "very_low",
            "low",
            "medium",
            "high",
            "very_high",
            "unknown"
          ]
        },
        "community": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Relevant expert community and jurisdiction or discipline boundaries."
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "assessed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "position": {
                "const": "no_consensus"
              }
            },
            "required": ["position"]
          },
          "then": {
            "properties": {
              "agreement_strength": {
                "const": "none"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "position": {
                "const": "unknown"
              }
            },
            "required": ["position"]
          },
          "then": {
            "properties": {
              "agreement_strength": {
                "const": "unknown"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "position": {
                "enum": ["supports", "opposes", "mixed"]
              }
            },
            "required": ["position"]
          },
          "then": {
            "properties": {
              "agreement_strength": {
                "enum": ["very_low", "low", "medium", "high", "very_high"]
              }
            }
          }
        }
      ]
    },
    "epistemicAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence_method",
        "theoretical_basis",
        "empirical_basis",
        "scientific_consensus",
        "last_assessed_at"
      ],
      "properties": {
        "confidence_method": {
          "const": "basis_matrix_v1",
          "description": "Versioned derivation method retained with the immutable inputs; the resulting confidence is a service projection."
        },
        "theoretical_basis": {
          "$ref": "#/$defs/basisAssessment"
        },
        "empirical_basis": {
          "$ref": "#/$defs/empiricalBasisAssessment"
        },
        "scientific_consensus": {
          "oneOf": [
            {
              "$ref": "#/$defs/consensusAssessment"
            },
            {
              "type": "null"
            }
          ],
          "description": "A scoped consensus assessment when one has been conducted and is relevant; null makes no claim about whether a consensus exists."
        },
        "last_assessed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "resource_type",
        "title",
        "authors",
        "publisher",
        "publication_year",
        "url",
        "archived_url",
        "identifiers",
        "peer_review_status",
        "accessed_at",
        "source_snapshot_id",
        "status_at_revision",
        "status_checked_at"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "resource_type": {
          "type": "string",
          "enum": [
            "meta_analysis",
            "systematic_review",
            "peer_reviewed_article",
            "preprint",
            "dataset",
            "official_statistics",
            "intergovernmental_assessment",
            "government_report",
            "academic_book",
            "book_chapter",
            "standard",
            "primary_document",
            "reputable_journalism",
            "expert_commentary",
            "webpage",
            "other"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "publisher": {
          "type": "string",
          "maxLength": 1000
        },
        "publication_year": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1000,
              "maximum": 3000
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "archived_url": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "identifiers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["doi", "pmid", "arxiv", "isbn"],
          "properties": {
            "doi": {
              "type": ["string", "null"]
            },
            "pmid": {
              "type": ["string", "null"]
            },
            "arxiv": {
              "type": ["string", "null"]
            },
            "isbn": {
              "type": ["string", "null"]
            }
          }
        },
        "peer_review_status": {
          "type": "string",
          "enum": [
            "peer_reviewed",
            "not_peer_reviewed",
            "not_applicable",
            "unknown"
          ]
        },
        "accessed_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_snapshot_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ],
          "description": "Content-addressed artifact ID where retention and copyright policy permit a snapshot."
        },
        "status_at_revision": {
          "type": "string",
          "enum": ["active", "corrected", "retracted", "withdrawn", "unknown"],
          "description": "Immutable snapshot of the source's known status when this thesis revision was accepted. Current status is supplied separately in the read view."
        },
        "status_checked_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_id",
        "stance",
        "evidence_role",
        "claim_or_finding",
        "explanation",
        "locator",
        "verification_status",
        "independence_cluster",
        "added_at"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "stance": {
          "type": "string",
          "enum": ["supports", "opposes", "mixed", "context_only"]
        },
        "evidence_role": {
          "type": "string",
          "enum": ["key", "supporting", "background"],
          "description": "The source's role in assessing this thesis, not a measure of moral, practical, or normative importance."
        },
        "claim_or_finding": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "description": "Paraphrase of the source's relevant finding; not an unsupported quotation."
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "description": "Why the finding bears on this thesis, including inferential limits."
        },
        "locator": {
          "type": "string",
          "maxLength": 1000,
          "description": "Page, section, table, figure, dataset slice, or other reproducible locator."
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "unverified",
            "metadata_verified",
            "content_checked",
            "independently_reproduced"
          ]
        },
        "independence_cluster": {
          "type": ["string", "null"],
          "maxLength": 200,
          "description": "Shared ID for sources that reuse the same underlying data, model, institution, or analysis and must not be counted as independent confirmations."
        },
        "added_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "hierarchyParent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thesis_id", "rationale"],
      "properties": {
        "thesis_id": {
          "$ref": "#/$defs/thesisId"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "How this thesis narrows the parent's proposition, such as by subject, mechanism, population, place, time, or conditions."
        }
      }
    },
    "hierarchy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_theses"],
      "properties": {
        "parent_theses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hierarchyParent"
          },
          "description": "Zero or more broader theses. Multiple parents make the hierarchy a directed acyclic graph rather than a tree. Child links are derived in the read view."
        }
      }
    },
    "thesisRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thesis_id", "relation", "explanation"],
      "properties": {
        "thesis_id": {
          "$ref": "#/$defs/thesisId"
        },
        "relation": {
          "type": "string",
          "enum": [
            "supports",
            "contradicts",
            "depends_on",
            "contextualizes",
            "overlaps",
            "supersedes"
          ],
          "description": "Directed relation read as 'this thesis [relation] the target thesis'. Inverse edges are generated by the service. For the symmetric overlaps relation, the service stores only the edge whose source thesis ID sorts first."
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_type", "actor_id", "display_name", "model"],
      "properties": {
        "actor_type": {
          "type": "string",
          "enum": ["human", "agent", "service", "mixed"]
        },
        "actor_id": {
          "$ref": "#/$defs/identifier"
        },
        "display_name": {
          "type": ["string", "null"],
          "maxLength": 500
        },
        "model": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["model_profile_id", "provider", "model_name"],
              "properties": {
                "model_profile_id": {
                  "$ref": "#/$defs/identifier"
                },
                "provider": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "model_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "actor_type": {
                "enum": ["agent", "mixed"]
              }
            },
            "required": ["actor_type"]
          },
          "then": {
            "properties": {
              "model": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "openQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "question", "bearing_on_thesis", "source_ids"],
      "properties": {
        "question_id": {
          "$ref": "#/$defs/identifier"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "description": "A presently unresolved, answerable research question. Every item in open_questions is open by definition."
        },
        "bearing_on_thesis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "description": "How resolving the question could materially affect the thesis's confidence, interpretation, mechanism, qualifications, or applicability."
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceId"
          },
          "uniqueItems": true,
          "description": "Sources that document or motivate the uncertainty; empty when the question is a reviewer inference."
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submitted_by",
        "project_ids",
        "task_ids",
        "run_ids",
        "source_snapshot_ids"
      ],
      "properties": {
        "submitted_by": {
          "$ref": "#/$defs/actor"
        },
        "project_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "task_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "run_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "source_snapshot_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
