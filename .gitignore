# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/

# Virtual environments and build output
.venv/
build/
dist/
*.egg-info/

# Test and coverage output
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local configuration and secrets
.env
.env.*
!.env.example
.secrets/
*.log
tmp/

# UBC runtime state must never be committed
.ubc/
artifacts/
browser-data/
downloads/
workspaces/

# Editors and operating systems
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~
